#!/bin/bash
# main으로 push할 때 이 맥에서 앱을 빌드해 GitHub Release로 올린다.
# 켜기(클론마다 한 번): git config core.hooksPath scripts/hooks
#
# git에는 push가 끝난 뒤 도는 훅이 없어서 push 직전에 빌드한다.
# 빌드가 실패하면 push도 중단된다. 태그를 먼저 push해 커밋을 원격에 올린 뒤 릴리스를 만든다.
# 자동 업데이트용 서명 키가 이 맥의 로그인 키체인(계정 live-trans)에 있어야 한다. 없으면 push가 중단된다.
set -euo pipefail

remote="$1"

main_sha=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        main_sha="$local_sha"
    fi
done
[ -n "$main_sha" ] || exit 0

build_number=$(git rev-list --count "$main_sha")
previous=$(git describe --tags --abbrev=0 "$main_sha^" 2>/dev/null || true)
notes=$(git log --no-merges --format='- %s (%h)' "${previous:+$previous..}$main_sha")

# 작업 트리의 미커밋 변경이 섞이지 않도록 push하는 커밋 그대로 꺼내서 빌드한다.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir "$work/src"
git archive "$main_sha" | tar -x -C "$work/src"

echo "[release] 빌드 $build_number 빌드 중 (${main_sha:0:7})"
(
    cd "$work/src"
    # 워크트리에서 push하면 git이 훅에 GIT_DIR을 넘긴다. 그대로 두면 패키지를 받는 git이 이 저장소를 가리켜 실패한다(실측).
    unset GIT_DIR
    xcodegen generate --quiet
    xcodebuild -project LiveTrans.xcodeproj -scheme LiveTrans -configuration Release \
        -derivedDataPath "$work/build" -quiet build CURRENT_PROJECT_VERSION="$build_number"
)
app="$work/build/Build/Products/Release/LiveTrans.app"
# 태그는 앱에 실제로 들어간 버전(project.yml의 0.1.<빌드 번호>)을 따른다.
tag="v$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist")"
zip="$work/LiveTrans-$tag.zip"
ditto -c -k --keepParent "$app" "$zip"

# 자동 업데이트: 앱에 박힌 공개 키와 짝인 개인 키로 zip에 서명하고, 업데이트 목록(appcast)을 만든다.
sparkle_bin="$work/build/SourcePackages/artifacts/sparkle/Sparkle/bin"
signing_key=$("$sparkle_bin/generate_keys" --account live-trans -p) || {
    echo "[release] 서명 키 조회 실패: $signing_key" >&2
    exit 1
}
app_key=$(/usr/libexec/PlistBuddy -c 'Print :SUPublicEDKey' "$app/Contents/Info.plist")
if [ "$signing_key" != "$app_key" ]; then
    echo "[release] 키체인의 서명 키(live-trans)가 앱의 SUPublicEDKey와 다릅니다. 이 키로 서명하면 설치된 앱이 업데이트를 받지 못합니다." >&2
    exit 1
fi
signature=$("$sparkle_bin/sign_update" --account live-trans "$zip") || {
    echo "[release] 업데이트 서명 실패: $signature" >&2
    exit 1
}
appcast="$work/appcast.xml"
cat > "$appcast" <<EOF
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>LiveTrans</title>
        <item>
            <title>$tag</title>
            <sparkle:version>$build_number</sparkle:version>
            <sparkle:shortVersionString>${tag#v}</sparkle:shortVersionString>
            <enclosure url="https://github.com/manuel71sj/live-trans/releases/download/$tag/LiveTrans-$tag.zip" $signature type="application/octet-stream"/>
        </item>
    </channel>
</rss>
EOF

# 앞선 push가 태그 push나 릴리스 등록 도중 실패했으면, 다시 push할 때 남은 태그·릴리스를 그대로 이어 쓴다.
git rev-parse -q --verify "refs/tags/$tag" >/dev/null || git tag "$tag" "$main_sha"
git push "$remote" "refs/tags/$tag"
if gh release view "$tag" >/dev/null 2>&1; then
    echo "[release] $tag 릴리스가 이미 있어 등록을 건너뜀"
    exit 0
fi
gh release create "$tag" "$zip" "$appcast" --verify-tag --title "$tag" \
    --notes "$(printf '## 변경 이력%s\n\n%s\n' "${previous:+ ($previous 이후)}" "$notes")"
echo "[release] $tag 등록 완료"
